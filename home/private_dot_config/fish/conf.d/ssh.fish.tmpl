# chezmoi:template:left-delimiter="#{{" right-delimiter="}}"
#{{ $sock := includeTemplate "ssh-auth-sock" . -}}
#{{ if $sock -}}
set -gx SSH_AUTH_SOCK #{{ $sock | quote }}
#{{ else if eq .chezmoi.os "linux" -}}
if status is-interactive; and command -sq keychain
    keychain --quiet --eval | source
end
#{{ end -}}
