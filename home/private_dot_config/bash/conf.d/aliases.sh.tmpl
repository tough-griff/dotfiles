# shellcheck shell=bash
# chezmoi:template:left-delimiter="#{{" right-delimiter="}}"
alias ag=rg # temporary so i remember
alias c=clear
alias cdf='cd #{{ .chezmoi.workingTree }}'
alias chez=chezmoi
#{{ if ne .clipboard "clip" -}}
alias clip='#{{ .clipboard }}'
#{{ end -}}
alias dog=doggo
alias e=edit
alias ea='edit --add'
alias edf='cd #{{ .chezmoi.workingTree }} && edit .'
alias o=open
alias tree='tree -aC --dirsfirst'
alias psa='ps aux'
alias where='type -a'
#{{ if and .work (eq .chezmoi.os "darwin") -}}
# Unset rather than point at ~/.claude: Claude Code only uses ~/.claude.json when this is unset.
alias claude-work='env -u CLAUDE_CONFIG_DIR claude'
alias claude-personal='env CLAUDE_CONFIG_DIR="$HOME/.claude.personal" claude'
#{{ end -}}
