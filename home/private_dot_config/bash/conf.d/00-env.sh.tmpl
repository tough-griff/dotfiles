# shellcheck shell=bash
# chezmoi:template:left-delimiter="#{{" right-delimiter="}}"
export FORCE_COLOR=1
export GITHUB_TOKEN=$(gh auth token)
export GITHUB_PERSONAL_ACCESS_TOKEN="$GITHUB_TOKEN"
export GPG_TTY=$(tty)
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LESS='-FgimrSwX -z-4'
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
#{{ if .wsl -}}
export COLORTERM=truecolor
#{{ end -}}
#{{ $netskope := "/Library/Application Support/Netskope/STAgent/data/netskope-cert-bundle.pem" -}}
#{{ if and .work (stat $netskope) -}}
# launchctl setenv in com.user.environment.globals.plist misses apps launched before the agent runs
export AWS_CA_BUNDLE=#{{ $netskope | squote }}
export CURL_CA_BUNDLE=#{{ $netskope | squote }}
export NODE_EXTRA_CA_CERTS=#{{ $netskope | squote }}
export REQUESTS_CA_BUNDLE=#{{ $netskope | squote }}
export SSL_CERT_FILE=#{{ $netskope | squote }}
#{{ end -}}
