{{- $ghPath := "" -}}
{{- /* Git config values need backslashes doubled for Windows paths */ -}}
{{- with lookPath "gh" -}}
{{-   $ghPath = . | replace "\\" "\\\\" | squote -}}
{{- end -}}
{{- $lfsPath := lookPath "git-lfs" -}}
{{- $deltaPath := lookPath "delta" -}}
{{- /* Delta can't pick a syntax theme per light/dark mode, so choose a feature from the macOS appearance on each run */ -}}
{{- $deltaFeatures := "dark-mode" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $deltaFeatures = `\"$(defaults read -g AppleInterfaceStyle >/dev/null 2>&1 && echo dark || echo light)-mode\"` -}}
{{- end -}}
[user]
  name = {{ .name | quote }}
  email = {{ .email | quote }}
{{- if not .ephemeral }}
  useConfigOnly = true
  signingKey = {{ onepasswordRead "op://Chezmoi/id_ed25519/public key" }}
{{- end }}
[add.interactive]
  useBuiltin = false
[alias]
  amend = "commit --amend --no-edit" # amend your last commit
  browse = "!gh browse"
  copyhash = "!git hash | {{ .clipboard }}"
  hash = "rev-parse --short HEAD" # print the most recent commit's hash
  sync = "!gh repo sync"
  up = "pull --rebase --autostash" # this is basically what `git-up` did
  uncommit = "reset --soft HEAD^" # go back before last commit
{{- range $name, $cmd := .gitAliases }}
  {{ $name }} = {{ $cmd | quote }}
{{- end }}
[branch]
  autoSetupRebase = always
[color]
  ui = true
[color "branch"]
  current = green bold
  local = green
  remote = yellow
[color "diff"]
  commit = green bold
  frag = magenta bold
  meta = yellow bold
  new = green bold
  old = red bold
  whitespace = red reverse
[color "diff-higlight"]
  newHighlight = green bold 52
  newNormal = green bold
  oldHighlight = red bold 52
  oldNormal = red bold
[color "status"]
  added = green bold
  changed = yellow bold
  branch = green bold
  unmerged = red bold
  untracked = magenta bold
{{- if not .ephemeral }}
[commit]
  gpgSign = true
{{- end }}
[core]
  autocrlf = input
  editor = vim
  ignoreCase = false
{{- if $deltaPath }}
  pager = delta --features {{ $deltaFeatures }}
{{- end }}
  precomposeUnicode = true
{{- if eq .chezmoi.os "windows" }}
  # Git's bundled ssh can't reach the agent's named pipe.
  sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
  trustctime = false
  untrackedCache = true
{{- if $ghPath }}
[credential "https://github.com"]
  helper =
  helper = !{{ $ghPath }} auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !{{ $ghPath }} auth git-credential
{{- end }}
[diff]
  colorMoved = default
  compactionHeuristic = true # let's give it a try!
  mnemonicPrefix = true
  renames = copies
[diff "bin"]
  textconv = hexdump -v -C
[fetch]
  prune = true
  pruneTags = true
{{- if $lfsPath }}
[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  process = git-lfs filter-process
  smudge = git-lfs smudge -- %f
{{- end }}
[format]
  pretty = "%C(red)%h%C(reset) -%C(yellow)%d%C(reset) %s %C(green)(%cr)%C(reset) %C(bold blue)<%an>%C(reset)"
{{- if not .ephemeral }}
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
{{-   if .onepasswordAgent }}
{{-     if .wsl }}
  program = {{ lookPath "op-ssh-sign-wsl.exe" | quote }}
{{-     else if eq .chezmoi.os "windows" }}
  program = {{ lookPath "op-ssh-sign" | quote }}
{{-     end }}
{{-   end }}
{{- end }}
[init]
  defaultBranch = main
{{- if $deltaPath }}
[interactive]
  diffFilter = delta --color-only --features {{ $deltaFeatures }}
[delta]
  navigate = true
[delta "dark-mode"]
  syntax-theme = One Dark Pro
[delta "light-mode"]
  syntax-theme = One Light Pro
{{- end }}
[merge]
  conflictStyle = zdiff3
[pull]
  rebase = true
[push]
  autoSetupRemote = true
  default = simple
  followTags = true
{{- if eq .chezmoi.os "windows" }}
# WSL files are owned by a Linux UID that Git for Windows can't match to the current user.
[safe]
  directory = "%(prefix)///wsl.localhost/*"
  directory = "%(prefix)///wsl$/*"
{{- end }}
[submodule]
  recurse = true
{{- if not .ephemeral }}
[tag]
  gpgSign = true
{{- end }}
[url "https://"]
  insteadOf = git://
[url "https://github.com/"]
  insteadOf = git@github.com:
