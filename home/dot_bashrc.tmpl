{{ template "homebrew" . }}
{{ template "xdg" . }}

PATH="${HOME}/.local/bin:${PATH}"
_dedup_path() {
  _new=""
  _oldifs=$IFS
  IFS=:
  for _dir in $PATH; do
    [ -n "${_dir}" ] || continue
    case ":${_new}:" in
      *":${_dir}:"*) ;;
      *) _new="${_new:+${_new}:}${_dir}" ;;
    esac
  done
  IFS=$_oldifs
  PATH=$_new
  unset _new _dir _oldifs
}
_dedup_path
unset -f _dedup_path
export PATH

# Everything below is interactive-only.
case $- in
  *i*) ;;
  *) return ;;
esac

for _f in "${HOME}/.config/bash/conf.d"/*.sh; do
  [ -r "${_f}" ] && . "${_f}"
done
unset _f

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi
