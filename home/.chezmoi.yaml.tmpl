{{/* Defaults */}}
{{- $ephemeral := false -}}
{{- $headless := false -}}
{{- $hostname := .chezmoi.hostname -}}
{{- $onepasswordMode := "service" -}}
{{- $wsl := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "ComputerName" | trim -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $wsl = .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{- end -}}

{{/* Detect GitHub codespaces, VSCode remote containers, Docker containers, Multipass VMs, and Vagrant boxes */}}
{{- if (or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (eq .chezmoi.username "root" "ubuntu" "vagrant" "vscode")) -}}
{{-   $ephemeral = true -}}
{{-   $headless = true -}}
{{- end -}}

{{- if not $ephemeral -}}
{{-   if stdinIsATTY -}}
{{-     $ephemeral = promptBoolOnce . "ephemeral" "ephemeral" $ephemeral -}}
{{-     $headless = promptBoolOnce . "headless" "headless" $headless -}}
{{-     if not (or $ephemeral $headless) -}}
{{-       $onepasswordMode = "account" -}}
{{-     end -}}
{{-     $hostname = promptStringOnce . "hostname" "hostname" $hostname -}}
{{-     $onepasswordMode = promptChoiceOnce . "onepasswordMode" "1password mode" (list "account" "connect" "service") $onepasswordMode }}
{{-   else -}}
{{-     $ephemeral = true -}}
{{-     $headless = true -}}
{{-   end -}}
{{- end -}}

{{/* Whether the 1Password SSH agent supplies keys; the .deb/.rpm installs live in /opt/1Password */}}
{{- $onepasswordAgent := and (not $headless) (not $ephemeral) -}}
{{- if and (eq .chezmoi.os "linux") (not $wsl) (not (stat "/opt/1Password")) -}}
{{-   $onepasswordAgent = false -}}
{{- end -}}

data:
  ephemeral: {{ $ephemeral }}
  headless: {{ $headless }}
  hostname: {{ $hostname | quote }}
  name: "Griffin Yourick"
  email: "gryphon92@gmail.com"
  work: {{ hasPrefix "GYOURICK-" $hostname }}
  onepasswordMode: {{ $onepasswordMode | quote }}
  onepasswordAgent: {{ $onepasswordAgent }}
  wsl: {{ $wsl }}
{{- if eq .chezmoi.os "darwin" }}
  macOS: {{ index (output "sw_vers" "-productVersion" | trim | splitList ".") 0 | atoi }}
{{- end }}

onepassword:
  mode: {{ $onepasswordMode | quote }}

{{- if eq $onepasswordMode "account" }}

env:
  OP_ACCOUNT: "my.1password.com"
{{- end }}

{{- if eq .chezmoi.os "windows" }}

interpreters:
  sh:
    command: "C:/Program Files/Git/bin/bash.exe"
{{- end }}

hooks:
  read-source-state:
    pre:
{{- if eq .chezmoi.os "windows" }}
      command: {{ joinPath .chezmoi.workingTree ".prepare.cmd" }}
{{- else }}
      command: {{ joinPath .chezmoi.workingTree ".prepare.sh" }}
{{- end }}
