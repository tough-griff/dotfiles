{{- if and .work (stat .netskope.bundle) -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.environment.globals</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>
{{- range .netskope.env }}
launchctl setenv {{ . }} {{ $.netskope.bundle | squote }}
{{- end }}
</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
{{ end -}}
