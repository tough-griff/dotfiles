{{- $sock := includeTemplate "ssh-auth-sock" . -}}
CanonicalizeHostname yes
CanonicalDomains {{ onepasswordRead "op://Chezmoi/ssh_config/canonicalDomains" }}

ControlMaster auto
ControlPath ~/.ssh/cm-%C
ControlPersist 10m

ServerAliveInterval 60

{{- range (onepasswordRead "op://Chezmoi/ssh_config/notesPlain" | fromYaml) }}

Host {{ .Host }}
{{-   range $k, $v := . }}
{{-     if ne $k "Host" }}
{{-       range (kindIs "slice" $v | ternary $v (list $v)) }}
  {{ $k }} {{ . }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}

{{- if $sock }}

Host *
  IdentityAgent {{ $sock | quote }}
{{- end }}
