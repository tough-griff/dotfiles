#!/bin/bash
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
set -eufo pipefail

# {{ template "homebrew" . }}

if [ ! "$(command -v brew)" ]; then
  echo "Install homebrew first! See: https://brew.sh"
  exit
fi

brew bundle --file=/dev/stdin <<EOF
# core deps
brew "bash"
brew "bat"
brew "direnv"
brew "doggo"
brew "duf"
brew "dust"
brew "eza"
brew "fd"
brew "fish"
brew "fzf"
brew "gh"
brew "git-delta"
brew "git-filter-repo"
brew "git-lfs"
brew "git"
brew "jq"
brew "less"
brew "ripgrep"
brew "shellcheck"
brew "starship"
brew "thefuck"
brew "tree"
brew "yq"
brew "zoxide"
EOF
