#!/bin/bash
# chezmoi:template:left-delimiter="#{{" right-delimiter="}}"
set -eufo pipefail

#{{ template "homebrew" . }}

if [ ! "$(command -v brew)" ]; then
  echo "Install homebrew first! See: https://brew.sh"
  exit
fi

brew bundle --file=/dev/stdin <<EOF
#{{- range .packages.brews }}
brew #{{ . | quote }}
#{{- end }}

#{{- if not .onepasswordAgent }}
brew "keychain"
#{{- end }}

#{{- if .wsl }}
#{{-   range .packages.brews_wsl }}
brew #{{ . | quote }}
#{{-   end }}
#{{- end }}

#{{- range .packages.casks }}
#{{-   if not (and $.wsl (eq . "1password-cli")) }}
cask #{{ . | quote }}
#{{-   end }}
#{{- end }}
EOF
