# chezmoi:template:left-delimiter="#{{" right-delimiter="}}"
$packages = @(
#{{- range .packages.winget }}
    #{{ . | quote }}
#{{- end }}
)

# winget exit codes that mean "nothing to do", not a real failure:
#   -1978335189  UPDATE_NOT_APPLICABLE
#   -1978335135  PACKAGE_ALREADY_INSTALLED (returned with --no-upgrade)
$ok = @(0, -1978335189, -1978335135)

foreach ($id in $packages) {
    $out = winget install --exact --id $id --no-upgrade --disable-interactivity --accept-package-agreements --accept-source-agreements 2>&1
    if ($ok -notcontains $LASTEXITCODE) {
        Write-Host "winget install $id failed (exit $LASTEXITCODE):`n$out"
    }
}

$modules = @(
#{{- range .packages.psmodules }}
    #{{ . | quote }}
#{{- end }}
)

# Runs under Windows PowerShell 5.1 (chezmoi's default ps1 interpreter), whose
# PowerShellGet breaks when PSModulePath is inherited from pwsh. Call pwsh by
# full path because a fresh install isn't on this process's PATH yet.
$pwsh = "$env:LOCALAPPDATA\Microsoft\WindowsApps\pwsh.exe"
& $pwsh -NoProfile -Command {
    foreach ($name in $args) {
        if (-not (Get-Module -ListAvailable -Name $name)) {
            Install-Module -Name $name -Scope CurrentUser -Force
        }
    }
} -args $modules
