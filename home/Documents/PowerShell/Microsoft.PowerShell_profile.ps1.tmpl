# chezmoi:template:left-delimiter="<#{{" right-delimiter="}}#>"
# Windows can't launch WinGet's Links symlinks in an SSH session, so put their
# targets ahead of them on PATH.
if ($env:SSH_CONNECTION) {
  $winGetTargetDirs = Get-ChildItem "$env:LOCALAPPDATA\Microsoft\WinGet\Links" -ErrorAction SilentlyContinue |
    Where-Object LinkType |
    ForEach-Object { Split-Path $_.Target } |
    Select-Object -Unique
  $env:PATH = (@($winGetTargetDirs) + $env:PATH) -join [IO.Path]::PathSeparator
}
foreach ($file in Get-ChildItem "$(Split-Path $PROFILE)\conf.d\*.ps1") { . $file.FullName }
Import-Module "gsudoModule.psd1"
Import-Module "WSLTabCompletion"

function Edit {
  $codeArgs = $args
  if ($args.Length -eq 0) {
    $workspaces = Get-ChildItem -Filter *.code-workspace -File
    $codeArgs += if ($workspaces) { $workspaces.Name } else { "." }
  } elseif (-not (Test-Path $args[-1])) {
    $codeArgs += "."
  }

  Start-Process -FilePath code.cmd -ArgumentList $codeArgs -WindowStyle Hidden
}

New-Alias -Name c -Value "clear"
function Set-Location-Dotfiles { Set-Location <#{{ .chezmoi.workingTree | quote }}#> }
New-Alias -Name cdf -Value "Set-Location-Dotfiles"
New-Alias -Name chez -Value "chezmoi"
New-Alias -Name e -Value "Edit"
function Edit-Add { Edit --add @args }
New-Alias -Name ea -Value "Edit-Add"
function Edit-Dotfiles { Set-Location <#{{ .chezmoi.workingTree | quote }}#>; Edit . }
New-Alias -Name edf -Value "Edit-Dotfiles"
New-Alias -name Which -Value "Get-Command"
function Write-Env { Get-ChildItem Env: | ForEach-Object { "$($_.Name)=$($_.Value)" } }
New-Alias -Name env -Value "Write-Env"
function Write-Split-Path { $env:PATH -split [IO.Path]::PathSeparator }
New-Alias -Name splitpath -Value "Write-Split-Path"

<#{{ if lookPath "starship" -}}#>
function Invoke-Starship-TransientFunction {
  &starship module character
}

function Set-TabTitle([string]$Job) {
  $dir = $PWD.ProviderPath
  if ($dir -eq $HOME -or $dir.StartsWith("$HOME\", [StringComparison]::OrdinalIgnoreCase)) {
    $dir = "~" + $dir.Substring($HOME.Length)
  }
  $host.UI.RawUI.WindowTitle = "$Job — $dir"
}

function Invoke-Starship-PreCommand {
  if ($PWD.Provider.Name -eq "FileSystem") {
    $host.UI.Write("$([char]27)]9;9;`"$($PWD.ProviderPath)`"$([char]27)\")
  }
  Set-TabTitle "pwsh"
}

# Mirrors PSReadLine's own definition; $? must be read first or it gets flushed.
function PSConsoleHostReadLine {
  $lastRunStatus = $?
  Microsoft.PowerShell.Core\Set-StrictMode -Off
  $line = [Microsoft.PowerShell.PSConsoleReadLine]::ReadLine($host.Runspace, $ExecutionContext, $lastRunStatus)
  $job = ($line.Trim() -split '\s+', 2)[0]
  if ($job) { Set-TabTitle $job }
  $line
}

$env:STARSHIP_CONFIG = "$HOME\.config\starship-pwsh.toml"
<#{{ output "starship" "init" "powershell" "--print-full-init" }}#>
Enable-TransientPrompt
<#{{ end -}}#>

