# chezmoi:template:left-delimiter="<#{{" right-delimiter="}}#>"
<#{{- if lookPath "docker" }}#>
# docker prints "Completion ended with directive" to stderr, which leaks to the console.
<#{{ output "docker" "completion" "powershell" | replace "\"$RequestComp\" 2>&1" "\"$RequestComp 2>`$null\" 2>&1" }}#>
<#{{- end }}#>
